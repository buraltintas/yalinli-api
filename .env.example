APP_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
MIGRATIONS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

BFF_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_LANGUAGE=tr
SUPPORTED_LANGUAGES=tr,en
CONTENT_REVIEW_MODE=auto_approve
CURRENT_TERMS_VERSION=2026-05-04-v1
CURRENT_PRIVACY_VERSION=2026-05-04-v1

EMAIL_FROM=info@yalinli.org
EMAIL_FROM_NAME=Yalınlı.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ADMIN_CONTACT_EMAIL=

OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

MEDIA_MAX_IMAGES_PER_ENTRY=3
MEDIA_MAX_FILE_SIZE_MB=5
STORAGE_BACKEND=gcs
GCP_PROJECT_ID=yalinli
GCS_BUCKET=yalinli-images-a1b2c3
GCS_UPLOAD_PREFIX=yalinli
GCS_SIGNED_URL_TTL=24h
SIGNATURE_HASH_SECRET=replace-with-a-long-random-secret

# Optional local fallback only (not primary setup)
# STORAGE_LOCAL_DIR=./var/storage
# MEDIA_PUBLIC_BASE_URL=http://localhost:8080/public/media

MAX_BODY_BYTES=1048576
MAX_MULTIPART_BYTES=20971520

RATE_LIMIT_ENTRY_PER_10MIN=3
RATE_LIMIT_COMMENT_PER_10MIN=10
RATE_LIMIT_MEDIA_PER_HOUR=10
RATE_LIMIT_REPORT_PER_10MIN=5
RATE_LIMIT_OTP_PER_MIN=1
RATE_LIMIT_OTP_PER_DAY=10
